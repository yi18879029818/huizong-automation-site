{
  "name": "huizong-next-migration",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=18.17 <25"
  },
  "scripts": {
    "predev": "node ./scripts/sync-legacy-public.mjs",
    "dev": "node ./scripts/dev-with-studio.mjs",
    "dev:site": "next dev",
    "dev:studio": "sanity dev --host localhost --port 3333",
    "prebuild": "node ./scripts/sync-legacy-public.mjs && node ./scripts/minify-legacy-assets.mjs",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "sanity:seed:stage3": "node ./scripts/seed-stage3-sample-content.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^14.2.35",
    "@portabletext/react": "^6.2.0",
    "@sanity/client": "^6.29.1",
    "@sanity/image-url": "^2.1.1",
    "cheerio": "^1.1.2",
    "next": "14.2.35",
    "next-sanity": "^9.12.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sanity": "^3.99.0",
    "styled-components": "^6.4.2"
  },
  "devDependencies": {
    "@alloc/quick-lru": "^5.2.0",
    "@opennextjs/cloudflare": "^1.12.0",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.17",
    "terser": "^5.44.0",
    "wrangler": "^4.38.0"
  }
}
